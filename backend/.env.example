MARKETMIND_ENVIRONMENT=development
MARKETMIND_DATABASE_URL=postgresql+psycopg://marketmind:marketmind@localhost:5432/marketmind
MARKETMIND_JWT_SECRET=replace-with-at-least-32-random-characters
MARKETMIND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
MARKETMIND_EXPOSE_DEVELOPMENT_TOKENS=true
MARKETMIND_SMTP_HOST=
MARKETMIND_SMTP_PORT=587
MARKETMIND_SMTP_USERNAME=
MARKETMIND_SMTP_PASSWORD=
MARKETMIND_SMTP_FROM_EMAIL=
MARKETMIND_SMTP_STARTTLS=true
MARKETMIND_RESEND_API_KEY=
MARKETMIND_RESEND_FROM_EMAIL=onboarding@resend.dev
MARKETMIND_INITIAL_ADMIN_EMAIL=admin@marketmind.local
MARKETMIND_INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!
MARKETMIND_RATE_LIMIT_ENABLED=true
MARKETMIND_RATE_LIMIT_AUTH_PER_MINUTE=15
MARKETMIND_RATE_LIMIT_PUBLIC_PER_MINUTE=60
MARKETMIND_RATE_LIMIT_AUTHENTICATED_PER_MINUTE=300
